# ==============================================================
# CourseVault environment configuration
# Copy to .env and fill in every value before running.
# NEVER commit .env — it contains secrets.
# ==============================================================

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://freecourses:CHANGE_ME@localhost:5432/freecourses?schema=public"

# --- App ---
# The public origin of your site, no trailing slash. Used for SEO, sitemap
# and absolute URLs. Example: https://yourdomain.com
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Keep "true" when running behind a reverse proxy (Nginx).
AUTH_TRUST_HOST="true"
# REQUIRED in production behind a proxy: the canonical public origin.
# Without it, auth redirects are built on the internal localhost address.
AUTH_URL="https://yourdomain.com"

# --- Admin bootstrap (read once by `prisma db seed`) ---
# Both are REQUIRED and the seed refuses to run without them — it will not
# invent a password, because the only values it could invent are an empty
# string or a constant published in this repository. Minimum 12 characters.
# Generate one with: openssl rand -base64 24
# Change it from the panel after the first sign-in.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD=""

# --- Google sign-in (required for course comments/reviews) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
# https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email sign-in / OTP delivery ---
# Resend API key (resend.com) — used to send signup verification, password
# reset and email-change OTP codes. Verify your sending domain in Resend for
# best deliverability.
RESEND_API_KEY=""
RESEND_FROM="Courses Monster <noreply@yourdomain.com>"
# Generate with: openssl rand -base64 32 (must differ from AUTH_SECRET / DOWNLOAD_TOKEN_SECRET)
OTP_HASH_SECRET=""

# --- Download flow ---
# Generate with: openssl rand -base64 32 (must differ from AUTH_SECRET)
DOWNLOAD_TOKEN_SECRET=""

# Cloudflare Turnstile captcha — create a free widget at
# https://dash.cloudflare.com/?to=/:account/turnstile
# Dev/test keys (always pass): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- vplink.in shortener ---
# Your API key from https://vplink.in (Tools -> Developer API).
# Leave empty to disable shortening (downloads then redirect straight to
# the destination URL).
VPLINK_API_KEY=""
VPLINK_API_BASE="https://vplink.in/api"

# --- Uploads ---
# Directory where admin-uploaded images are stored (created automatically).
# Use an absolute path in production, e.g. /var/lib/coursevault/uploads
UPLOAD_DIR="./uploads"

# --- Optional Redis (only needed for multi-node deployments) ---
REDIS_URL=""

# --- Telegram bot (optional; the bot is inert until TELEGRAM_BOT_TOKEN is set) ---
# Issued by @BotFather. Deployment secret only — never commit a real value.
TELEGRAM_BOT_TOKEN=""
# Unguessable path segment for the webhook route (A-Za-z0-9_-).
TELEGRAM_WEBHOOK_PATH=""
# Echoed by Telegram in X-Telegram-Bot-Api-Secret-Token (1-256 chars, A-Za-z0-9_-).
TELEGRAM_WEBHOOK_SECRET=""
# Shared secret for the cron-driven broadcast pump (POST /api/telegram/broadcast/run).
TELEGRAM_CRON_SECRET=""
# Public bot username (no @) — used only to build t.me deep links on the site.
NEXT_PUBLIC_TELEGRAM_BOT=""
# Telegram user ids allowed to use in-bot admin commands (comma-separated).
# Empty means nobody; /admin then behaves exactly like an unknown command.
TELEGRAM_ADMIN_IDS=""
# Required-channel membership gate. The bot must be an administrator of this
# channel for getChatMember to work reliably. Empty disables the gate.
TELEGRAM_REQUIRED_CHANNEL="@Matrix_Bots_in"
TELEGRAM_REQUIRED_CHANNEL_URL="https://t.me/Matrix_Bots_in"

# ── Social downloader (Bot9) ──────────────────────────────────────────────
# Internal downloader API. It listens on loopback only and is never proxied by
# nginx, so the browser cannot reach it: every request goes browser → Next.js →
# Bot9. Leave either value empty to disable the /downloader feature entirely —
# the site then reports it as unavailable rather than failing at runtime.
SOCIAL_DOWNLOADER_URL="http://127.0.0.1:8791"
# Must match SOCIAL_DOWNLOADER_INTERNAL_SECRET in Bot9's own .env. Never sent to
# a browser; keep it out of NEXT_PUBLIC_* and out of client components.
SOCIAL_DOWNLOADER_INTERNAL_SECRET=""
# Telegram downloader bot shown as an alternative on /downloader. This is Bot9,
# NOT the CourseVault bot: @Coursevault_in_bot serves courses and is configured
# via NEXT_PUBLIC_TELEGRAM_BOT above. Username only, no "@".
NEXT_PUBLIC_DOWNLOADER_TELEGRAM_BOT="You_tubevideodownloader_bot"

# --- Premium (NOWPayments crypto checkout) ---
# Required for checkout. The IPN secret is the one shown in the NOWPayments
# dashboard (Settings -> Payments -> IPN); set the IPN callback URL there to
# https://<your-domain>/api/payments/nowpayments/ipn
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# Coins are loaded from the account itself (/merchant/coins) and each one is
# offered only when its live /min-amount fits the plan price; nothing to set.
# Tests only: point the client at a local mock. Leave unset in production.
NOWPAYMENTS_API_BASE=""
# Optional: "off" disables the in-process expiry/reminder scheduler (runs every
# 15 min). Use it when running several app instances and driving the job from
# cron instead, via POST /api/premium/cron with header x-cron-secret.
PREMIUM_JOBS=""
PREMIUM_CRON_SECRET=""

# --- Premium (Razorpay: UPI / cards / netbanking) — ALL REQUIRED ---
# The server refuses to start if any of these is missing or malformed.
# Keys: Razorpay Dashboard -> Account & Settings -> API Keys. Only the key id
# is ever sent to the browser; the key secret and webhook secret stay server-side.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Webhooks -> the secret you set for
# https://<your-domain>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""
# Fixed USD -> INR rate for Premium prices (USD prices live in src/lib/premium-plans.ts).
# 100 means $1 = Rs 100.
RAZORPAY_USD_INR_RATE="100"
# The only contact shown to customers anywhere (site, bot, checkout), e.g. @YourSupport
SUPPORT_TELEGRAM=""
# Tests only: point the client at a local mock. Leave unset in production.
RAZORPAY_API_BASE=""
